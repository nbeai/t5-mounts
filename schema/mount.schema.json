{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t5.beai.kr/schema/t5.mount.v1.json",
  "title": "티파이브 장착 항목 명세(검수 증명서) t5.mount.v1",
  "description": "장착 항목 하나의 정체·출처·지문·라이선스·권한·지원 운영체제·검수 결과. tools/lib/validate.mjs 가 이 파일을 그대로 읽어 검사한다(지원하는 키워드: type, required, properties, additionalProperties, enum, const, pattern, minLength, maxLength, minItems, items).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "kind", "name", "summary", "version", "status", "origin", "files", "license", "permissions", "platforms", "requires", "t5MinVersion", "review"],
  "properties": {
    "schema": { "const": "t5.mount.v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64, "description": "폴더 이름과 같다. 티파이브 스킬 이름 규칙과 같다." },
    "kind": { "enum": ["skill", "mcp", "cli", "plugin", "hook"], "description": "들어 있는 최상위 폴더와 맞아야 한다(skills/·mcp/·cli/·plugins/·hooks/)." },
    "name": { "type": "string", "minLength": 1, "maxLength": 40, "description": "장착 목록에 보일 이름(한국어)." },
    "summary": { "type": "string", "minLength": 1, "maxLength": 120, "description": "한 줄 소개. 사장님이 읽고 알아듣는 말로." },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "status": { "enum": ["draft", "listed", "withdrawn"], "description": "draft: 검수 중·진열 안 함. listed: 진열대에 보임. withdrawn: 내림(기록은 남김)." },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "modified", "upstream", "note"],
      "properties": {
        "type": { "enum": ["ours", "external"], "description": "ours: 우리가 만듦. external: 남이 만든 원형을 링크·고정 판으로 가리킴." },
        "modified": { "type": "boolean", "description": "external 일 때 우리가 손본 얇은 연결·설정이 있나." },
        "upstream": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["url", "ref", "commit"],
          "properties": {
            "url": { "type": "string", "pattern": "^https://" },
            "ref": { "type": "string", "minLength": 1, "description": "태그나 판 이름." },
            "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$", "description": "고정 커밋 전체 해시." }
          }
        },
        "note": { "type": "string" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "description": "항목 폴더 안 파일 전부(mount.json 제외)의 상대 경로·크기·sha256. 빠지거나 더 있으면 검사가 떨어진다.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^[^/\\\\][^\\\\]*$" },
          "bytes": { "type": "integer" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "decided", "redistribution", "upstreamLicense", "note"],
      "properties": {
        "spdx": { "type": ["string", "null"], "description": "결정된 라이선스의 SPDX 이름. 미정이면 null." },
        "decided": { "type": "boolean", "description": "오너가 정했나. false 인 항목은 listed 가 될 수 없다." },
        "redistribution": { "enum": ["allowed", "links_only", "forbidden", "undecided"], "description": "allowed: 우리 저장소에 사본을 둘 수 있음. links_only: 원형은 링크만." },
        "upstreamLicense": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["spdx", "url", "checkedAt"],
          "properties": {
            "spdx": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "pattern": "^https://" },
            "checkedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
          }
        },
        "note": { "type": "string" }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "programs", "internet", "externalSend", "money"],
      "properties": {
        "files": { "$ref": "#/$defs/permission" },
        "programs": { "$ref": "#/$defs/permission" },
        "internet": { "$ref": "#/$defs/permission" },
        "externalSend": { "$ref": "#/$defs/permission" },
        "money": { "$ref": "#/$defs/permission" }
      }
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["macos", "windows"],
      "properties": {
        "macos": { "$ref": "#/$defs/platform" },
        "windows": { "$ref": "#/$defs/platform" }
      }
    },
    "requires": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "t5MinVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "result", "reviewer", "checks"],
      "properties": {
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "result": { "enum": ["pass", "conditional", "fail", "pending"] },
        "reviewer": { "type": "string", "minLength": 1 },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item", "method", "result"],
            "properties": {
              "item": { "type": "string", "minLength": 1, "description": "CHECKLIST.md 의 항목 번호와 이름(예: 「1. 티파이브가 받아들이나」)." },
              "method": { "type": "string", "minLength": 1, "description": "무엇을 어떻게 확인했나(명령·파일·판)." },
              "result": { "enum": ["pass", "fail", "not_checked", "not_applicable"] },
              "note": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uses", "note"],
      "properties": {
        "uses": { "type": "boolean" },
        "note": { "type": "string", "minLength": 1, "description": "무엇을 어디까지 쓰나 사장님 말로." }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "verified", "note"],
      "properties": {
        "supported": { "type": "boolean" },
        "verified": { "type": "boolean", "description": "그 운영체제에서 실제로 돌려 확인했나." },
        "note": { "type": "string" }
      }
    }
  }
}
