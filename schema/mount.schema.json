{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t5.beai.kr/schema/t5.mount.v1.json",
  "title": "티파이브 장착 항목 명세(검수 증명서) t5.mount.v1",
  "description": "장착 항목 하나의 정체·출처·지문·라이선스·권한·지원 운영체제·검수 결과. tools/lib/mounts.mjs 가 이 파일을 그대로 읽어 검사한다. 항목 폴더에는 판 이력 CHANGELOG.md 가 반드시 있고 지금 version 의 제목(## <version>)이 들어 있어야 한다(지원하는 키워드: type, required, properties, additionalProperties, enum, const, pattern, minLength, maxLength, minItems, items).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "kind",
    "category",
    "name",
    "summary",
    "version",
    "status",
    "origin",
    "overrides",
    "files",
    "license",
    "permissions",
    "platforms",
    "requires",
    "t5MinVersion",
    "review"
  ],
  "properties": {
    "schema": {
      "const": "t5.mount.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64,
      "description": "영문 짧은 이름. 폴더 이름과 같고 티파이브 스킬 이름 규칙(소문자·숫자·하이픈, 64자 이하)을 따른다."
    },
    "kind": {
      "enum": [
        "skill",
        "mcp",
        "cli",
        "plugin",
        "hook"
      ],
      "description": "들어 있는 최상위 폴더와 맞아야 한다(skills/·mcp/·cli/·plugins/·hooks/)."
    },
    "category": {
      "enum": [
        "홍보·콘텐츠",
        "문서·서식",
        "돈·장부",
        "웹 업무",
        "사진·영상",
        "컴퓨터 관리"
      ],
      "description": "사장님 일 기준 분류. 진열대가 이 이름으로 묶어 보여 준다. 늘리거나 이름을 바꾸면 이 목록 하나만 고친다(index.json 의 categories 가 여기서 나온다)."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "한국어 표시 이름(장착 목록·진열대에 보임). 한글이 들어가야 한다. 폴더 이름은 id(영문 짧은 이름)."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "한 줄 소개. 사장님이 읽고 알아듣는 말로."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "status": {
      "enum": [
        "draft",
        "listed",
        "withdrawn"
      ],
      "description": "draft: 검수 중·진열 안 함. listed: 진열대에 보임. withdrawn: 내림(기록은 남김)."
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "upstream",
        "changes",
        "note"
      ],
      "properties": {
        "type": {
          "enum": [
            "t5_made",
            "reviewed_upstream",
            "t5_modified"
          ],
          "description": "t5_made: 티파이브 제작. reviewed_upstream: 검수 통과(원형 그대로). t5_modified: 티파이브 수정판(원형 + 우리 고침)."
        },
        "upstream": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "url",
            "ref",
            "commit"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "description": "태그나 판 이름."
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$",
              "description": "고정 커밋 전체 해시."
            }
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "t5_modified 일 때 원형에서 바꾼 점(한 줄씩, 하나 이상). 다른 출처는 빈 목록."
        },
        "note": {
          "type": "string"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "description": "항목 폴더 안 파일 전부(mount.json 제외)의 상대 경로·크기·sha256. 빠지거나 더 있으면 검사가 떨어진다.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[^/\\\\][^\\\\]*$"
          },
          "bytes": {
            "type": "integer"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdx",
        "decided",
        "redistribution",
        "upstreamLicense",
        "note"
      ],
      "properties": {
        "spdx": {
          "type": [
            "string",
            "null"
          ],
          "description": "결정된 라이선스의 SPDX 이름. 미정이면 null."
        },
        "decided": {
          "type": "boolean",
          "description": "오너가 정했나. false 인 항목은 listed 가 될 수 없다."
        },
        "redistribution": {
          "enum": [
            "allowed",
            "links_only",
            "forbidden",
            "undecided"
          ],
          "description": "allowed: 우리 저장소에 사본을 둘 수 있음. links_only: 원형은 링크만."
        },
        "upstreamLicense": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "spdx",
            "url",
            "checkedAt"
          ],
          "properties": {
            "spdx": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "checkedAt": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "programs",
        "internet",
        "externalSend",
        "money"
      ],
      "properties": {
        "files": {
          "$ref": "#/$defs/permission"
        },
        "programs": {
          "$ref": "#/$defs/permission"
        },
        "internet": {
          "$ref": "#/$defs/permission"
        },
        "externalSend": {
          "$ref": "#/$defs/permission"
        },
        "money": {
          "$ref": "#/$defs/permission"
        }
      }
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "macos",
        "windows"
      ],
      "properties": {
        "macos": {
          "$ref": "#/$defs/platform"
        },
        "windows": {
          "$ref": "#/$defs/platform"
        }
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "t5MinVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "result",
        "reviewer",
        "checks"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "result": {
          "enum": [
            "pass",
            "conditional",
            "fail",
            "pending"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item",
              "method",
              "result"
            ],
            "properties": {
              "item": {
                "type": "string",
                "minLength": 1,
                "description": "CHECKLIST.md 의 항목 번호와 이름(예: 「1. 티파이브가 받아들이나」)."
              },
              "method": {
                "type": "string",
                "minLength": 1,
                "description": "무엇을 어떻게 확인했나(명령·파일·판)."
              },
              "result": {
                "enum": [
                  "pass",
                  "fail",
                  "not_checked",
                  "not_applicable"
                ]
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "overrides": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "baseSkill",
        "baseProductVersion",
        "baseContentSha256",
        "changes",
        "rollback"
      ],
      "description": "티파이브에 이미 실린 기본 스킬을 같은 이름·높은 판으로 바꿔 내보낼 때만 채운다(오너 결정 2026-10-26). 아니면 null.",
      "properties": {
        "baseSkill": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "덮어쓰는 기본 스킬 이름. id 와 같아야 한다."
        },
        "baseProductVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "description": "그 기본 스킬이 실린 티파이브 판(기본 판). 기본 스킬 머리말에는 판 번호 칸이 없어 티파이브 판과 내용 지문으로 기본 판을 가리킨다."
        },
        "baseContentSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "그 판에 실린 기본 스킬 SKILL.md 의 sha256."
        },
        "changes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "기본 판에서 바뀐 점(한 줄씩)."
        },
        "rollback": {
          "type": "string",
          "minLength": 1,
          "description": "되돌리는 법(사장님 말로). 예: 설정 › 장착 목록에서 이 항목을 빼면 기본 판으로 돌아가요."
        }
      }
    }
  },
  "$defs": {
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uses",
        "note"
      ],
      "properties": {
        "uses": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "description": "무엇을 어디까지 쓰나 사장님 말로."
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported",
        "verified",
        "note"
      ],
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "verified": {
          "type": "boolean",
          "description": "그 운영체제에서 실제로 돌려 확인했나."
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
