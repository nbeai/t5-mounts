   "text": 900,
   "muted": 800,
   "mutedLargeOnly": 600,
   "decoLine": 200,
   "funcLine": 600,
   "bg": 25,
   "surface": 50,
   "surface2": 100,
   "soft": 150,
   "accentBlock": "800·900 + onAccent, 한 장에 하나",
   "smallMeaningfulShape": "600 이상",
   "icon": "옆 글자와 같은 색",
   "chart": "강조 계열 하나 + 회색 막대(200) + 숫자 이름표, 증감은 ▲▼"
  },
  "dark": {
   "bg": 950,
